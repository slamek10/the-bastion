# The Bastion: every variable it reads. A missing part shows "not configured"; nothing crashes.

# port (the Dockerfile sets 5040)
PORT=5040

# Home Assistant: one websocket on the server, the token never reaches the browser
HASS_URL=http://192.168.10.12:8123
HASS_TOKEN=

# the shared Bastion login: the same value as in every other Bastion app (32+ characters)
BASTION_SESSION_SECRET=
# optional: a password for this app's own login form (it mints the shared cookie);
# without it, sign in through any other Bastion app
APP_PASSWORD=
# how this app is opened; https here makes the login cookie Secure.
# Also how bastion-ai reaches this app's /mcp (the Orchestrator robot's tools)
APP_URL=http://192.168.10.12:5040
# optional: a different address for bastion-ai to reach /mcp
BASTION_AI_MCP_URL=

# bastion-ai: the robots are Claude agents through it
BASTION_AI_URL=http://192.168.10.12:5095
BASTION_AI_TOKEN=

# the other Bastion apps (their /_api streams and /mcp/key)
HA_APP_URL=http://192.168.10.12:5050
HEAT_URL=http://192.168.10.12:5090
CAMS_URL=http://192.168.10.12:5070
WATCH_URL=http://192.168.10.12:5080
# bastion-ai's /health (defaults to BASTION_AI_URL)
AI_URL=http://192.168.10.12:5095

# where agents.json and bindings.json are kept
DATA_DIR=./data
